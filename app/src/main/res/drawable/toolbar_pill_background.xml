<?xml version="1.0" encoding="utf-8"?>
<!-- Oversized corner radius: Android clamps it to min(width,height)/2 automatically, so the same
     drawable renders as a pill when wide+short (expanded toolbar) and a perfect circle when the
     container is square (minimized handle) - no need to swap drawables between states. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="#FFFDFDFD" />
    <stroke
        android:width="1dp"
        android:color="#FF222222" />
</shape>
