<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/toolbar_white_bottom_line"
            android:gravity="center_vertical"
            android:paddingStart="1dp"
            android:paddingTop="2dp"
            android:paddingEnd="1dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:id="@+id/toolbarRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/brushGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/brushButtonRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                    <ImageButton
                        android:id="@+id/buttonEraser"
                        android:layout_width="36dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="3dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Eraser"
                        android:paddingStart="2dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="3dp"
                        android:paddingBottom="5dp"
                        android:src="@drawable/ic_eraser_black_24" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="#22000000" />

                <LinearLayout
                    android:id="@+id/widthGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/widthSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:max="99"
                        android:minWidth="0dp"
                        android:minHeight="28dp"
                        android:paddingStart="3dp"
                        android:paddingLeft="0dp"
                        android:paddingEnd="0dp"
                        android:paddingRight="0dp"
                        android:progressDrawable="@drawable/slider_track_rounded"
                        android:splitTrack="false"
                        android:thumbOffset="0dp"
                        android:thumb="@drawable/slider_thumb_invisible" />

                    <TextView
                        android:id="@+id/widthValueLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="80 px"
                        android:textColor="#222222"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/zoomValueLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/menu_item_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="40dp"
                        android:paddingStart="4dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="4dp"
                        android:text="100%"
                        android:textColor="#222222"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:background="#22000000" />

                <LinearLayout
                    android:id="@+id/colorGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/swatchBlack"
                        android:layout_width="32dp"
                        android:layout_height="32dp" />

                    <View
                        android:id="@+id/swatchWhite"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp" />

                    <View
                        android:id="@+id/swatchBlue"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="#22000000" />

                <LinearLayout
                    android:id="@+id/topButtonsGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/buttonLayers"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Layers"
                        android:padding="8dp"
                        android:src="@drawable/ic_layers_stack_black_24" />

                    <ImageButton
                        android:id="@+id/buttonMenu"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="2dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Menu"
                        android:padding="8dp"
                        android:src="@drawable/ic_hamburger_two_lines_black_24" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.auxnon.booxnote.HardwarePenSurfaceView
            android:id="@+id/penSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layerPanel"
        android:layout_width="280dp"
        android:layout_height="380dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/floating_panel_background"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/layerDragHandle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Layers"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/buttonAddLayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Add Layer"
                android:padding="6dp"
                android:src="@drawable/ic_add_black_24" />

            <ImageButton
                android:id="@+id/buttonRemoveLayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:contentDescription="Remove Layer"
                android:padding="6dp"
                android:src="@drawable/ic_remove_black_24" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/layerRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/colorPickerPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/color_picker_panel_background"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <com.auxnon.booxnote.CircularColorPickerView
            android:id="@+id/colorPickerView"
            android:layout_width="276dp"
            android:layout_height="276dp"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/textColorHex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="#000000"
            android:textColor="#F2F2F2"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fileMenuPanel"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/floating_panel_background"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/buttonLoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Open"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Save as PNG"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonSaveFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Save as JSON"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Share"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonClearLayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Clear layer"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonClearFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="New File"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonResetView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Reset view"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="About"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
