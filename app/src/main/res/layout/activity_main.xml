<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.auxnon.booxnote.HardwarePenSurfaceView
        android:id="@+id/penSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF" />

    <LinearLayout
        android:id="@+id/toolbarPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/toolbar_pill_background"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dp">

        <ImageButton
            android:id="@+id/toolbarHandle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Move / minimize toolbar"
            android:padding="8dp"
            android:src="@drawable/ic_toolbar_handle" />

        <LinearLayout
            android:id="@+id/toolbarContentGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/toolSlotsGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/toolSlot0"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Tool 1"
                    android:padding="9dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/toolSlot1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Tool 2"
                    android:padding="9dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/toolSlot2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Tool 3"
                    android:padding="9dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#22000000" />

            <ImageButton
                android:id="@+id/buttonEraser"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Eraser"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp"
                android:src="@drawable/ic_eraser_black_24" />

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#22000000" />

            <TextView
                android:id="@+id/zoomValueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/menu_item_background"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="40dp"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:text="100%"
                android:textColor="#222222"
                android:textSize="14sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="#22000000" />

            <LinearLayout
                android:id="@+id/topButtonsGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonLayers"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Layers"
                    android:padding="8dp"
                    android:src="@drawable/ic_layers_stack_black_24" />

                <ImageButton
                    android:id="@+id/buttonMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Menu"
                    android:padding="8dp"
                    android:src="@drawable/ic_hamburger_two_lines_black_24" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layerPanel"
        android:layout_width="280dp"
        android:layout_height="380dp"
        android:layout_gravity="top|start"
        android:background="@drawable/floating_panel_background"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/layerDragHandle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Layers"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/buttonAddLayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Add Layer"
                android:padding="6dp"
                android:src="@drawable/ic_add_black_24" />

            <ImageButton
                android:id="@+id/buttonRemoveLayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:contentDescription="Remove Layer"
                android:padding="6dp"
                android:src="@drawable/ic_remove_black_24" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/layerRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolModalPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/floating_panel_background"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/modalColorButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Color" />

            <TextView
                android:id="@+id/modalSizeButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/menu_item_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Size: 5 px"
                android:textColor="#222222"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modalColorSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.auxnon.booxnote.CircularColorPickerView
                android:id="@+id/modalColorPickerView"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/modalColorHexValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="#000000"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modalSizeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/modalSizeSeekBar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:max="99"
                android:minHeight="32dp"
                android:progressDrawable="@drawable/slider_track_rounded"
                android:splitTrack="false"
                android:thumb="@drawable/slider_thumb_invisible" />

            <TextView
                android:id="@+id/modalSizeValueLabel"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="5 px"
                android:textColor="#222222"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="#22000000" />

        <LinearLayout
            android:id="@+id/brushGridRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/brushGridRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fileMenuPanel"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/floating_panel_background"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/buttonLoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Open"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Save as PNG"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonSaveFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Save as JSON"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Share"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonClearLayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Clear layer"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonClearFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="New File"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonResetView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="Reset view"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000" />

        <TextView
            android:id="@+id/buttonAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/menu_item_background"
            android:gravity="start|center_vertical"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:text="About"
            android:textColor="@drawable/menu_item_text_color"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
